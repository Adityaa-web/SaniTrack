# SaniTrack Supabase Configuration
# Fill in your project keys from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# If Supabase keys are not set or offline, SaniTrack automatically activates
# the rich Pune Pilot Offline Demo mode with persistent LocalStorage state.
VITE_ENABLE_MOCK_FALLBACK=true
